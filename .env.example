# Copy to .env locally. Never commit actual credentials.
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Draft review output budget (1–50000). Higher budgets may increase latency and cost.
OPENROUTER_REVIEW_MAX_TOKENS=50000

# Build 3 foundation (optional until library UI integration).
# Hosted project URL and PUBLISHABLE key only. Never use sb_secret_ or service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key
# Public Web OAuth client ID, also configured in Supabase's Google provider.
# The app uses Google ID tokens; no Google client secret belongs in app settings.
GOOGLE_CLIENT_ID=replace_with_web_client_id.apps.googleusercontent.com

# Keep false until actual SQL/RLS + two-account verification on this project.
RUBRIC_RADAR_ARCHIVE_ENABLED=false
